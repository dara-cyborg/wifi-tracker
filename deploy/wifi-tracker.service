[Unit]
Description=WiFi Payment Tracker
After=network.target

[Service]
Type=simple
User=mongkol
Group=mongkol
WorkingDirectory=/opt/wifi-tracker
# Load environment variables from .env (ensure file exists and is owned by the service user)
EnvironmentFile=/opt/wifi-tracker/.env
# Ensure stdout/stderr go to journal
StandardOutput=journal
StandardError=journal
ExecStart=/opt/wifi-tracker/.venv/bin/uvicorn backend.app:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

# Notes:
# - Ensure the .env contains a correct DATABASE_URL and the sqlite file (if used) is writable by the 'mongkol' user.
# - If using a relative sqlite path, WorkingDirectory must point to the directory containing the DB file.